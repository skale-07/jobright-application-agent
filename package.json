{
  "name": "jobright-application-agent",
  "version": "0.1.0",
  "description": "Deterministic Playwright job-application processor for JobRight \u2192 ATS \u2192 Outlook drafts",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/cli/index.ts migrate",
    "cli": "tsx src/cli/index.ts",
    "run": "tsx src/cli/index.ts run",
    "run:dry": "tsx src/cli/index.ts run --dry-run",
    "dashboard": "tsx src/cli/index.ts dashboard",
    "inspect": "tsx src/cli/index.ts inspect",
    "retry": "tsx src/cli/index.ts retry",
    "resume:essay": "tsx src/cli/index.ts resume-essay",
    "resume:download": "tsx src/cli/index.ts resume:download",
    "materials:register": "tsx src/cli/index.ts materials:register",
    "submit": "tsx src/cli/index.ts submit",
    "nav:resolve": "tsx src/cli/index.ts nav:resolve",
    "review": "tsx src/cli/index.ts review",
    "review:resolve": "tsx src/cli/index.ts review:resolve",
    "contacts:extract": "tsx src/cli/index.ts contacts:extract",
    "email:generate": "tsx src/cli/index.ts email:generate",
    "draft:create": "tsx src/cli/index.ts draft:create",
    "draft:verify": "tsx src/cli/index.ts draft:verify",
    "agent:author": "tsx src/cli/index.ts agent:author",
    "report": "tsx src/cli/index.ts report",
    "login:jobright": "tsx src/cli/index.ts login --service jobright",
    "login:jobright:cdp": "tsx src/cli/index.ts login --service jobright --cdp http://127.0.0.1:9222",
    "chrome:debug:jobright": "tsx scripts/start-chrome-debug-jobright.ts",
    "login:linkedin": "tsx src/cli/index.ts login --service linkedin",
    "login:outlook": "tsx src/cli/index.ts login --service outlook",
    "candidate:encrypt-sensitive": "tsx src/cli/index.ts candidate:encrypt-sensitive",
    "record:jobright": "tsx src/cli/index.ts record-jobright",
    "recorder:promote": "tsx src/cli/index.ts recorder:promote",
    "discover": "tsx src/cli/index.ts discover",
    "enqueue": "tsx src/cli/index.ts enqueue",
    "ats:inspect": "tsx src/cli/index.ts ats:inspect",
    "ats:fill": "tsx src/cli/index.ts ats:fill",
    "ats:fill-outcomes": "tsx src/cli/index.ts ats:fill-outcomes",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:forbidden": "tsx scripts/check-forbidden.ts",
    "check:secrets": "tsx scripts/check-secrets-staged.ts",
    "verify:phase1": "npm run typecheck && npm run test && npm run migrate && npm run check:forbidden && npm run cli -- --help",
    "verify:phase2": "npm run typecheck && npm run test && npm run migrate && npm run check:forbidden && npm run check:secrets && npm run report",
    "verify:phase2b": "npm run typecheck && npm run test && npm run migrate && npm run check:forbidden && npm run check:secrets && npm run cli -- --help",
    "verify:phase3": "npm run typecheck && npm run test && npm run migrate && npm run check:forbidden && npm run discover -- --fixture --max-jobs 5",
    "verify:phase4": "npm run typecheck && npm run test && npm run migrate && npm run check:forbidden && npm run ats:inspect -- --all-fixtures",
    "verify:phase5": "tsx scripts/verify-phase5.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "openai": "^7.4.0",
    "playwright": "^1.61.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
