# Copy to .env for local overrides. Do NOT put CANDIDATE_DATA_KEY plaintext here
# next to sensitive-profile.enc — use OS secret store / DPAPI (Phase 2).

NODE_ENV=development
DATABASE_PATH=data/app.sqlite

# Fallback resume auto-attached when an application reaches the materials
# stage with none registered (needed for unattended L3 sessions). Plain path.
# Point this at your REAL resume file — an application that reaches the
# materials stage with none registered parks here otherwise (8 of 14 apps
# in one live session died on the placeholder). auto:cycle preflight now
# reports whether this file exists before the queue runs.
DEFAULT_RESUME_PATH=private/candidate/resumes/default.pdf
LOG_LEVEL=info

# Staged rollout (defaults fail-closed)
DRY_RUN=true
FORM_FILL_ENABLED=false
SUBMIT_ENABLED=false
SUBMIT_REQUIRES_LOCAL_CONFIRMATION=true
MAX_UNATTENDED_SUBMISSIONS_PER_RUN=0
OUTLOOK_DRAFTS_ENABLED=false
LINKEDIN_ENRICHMENT_ENABLED=false
JOBRIGHT_AUTOFILL_ENABLED=false
NATIVE_AUTOFILL_ENABLED=false

# Dashboard (Phase 13)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8788

# Operator console (frontend + guarded mutation API). Localhost only.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8899

# L3 kill switch: the console automation worker (unattended apply while
# armed) is refused unless this is true, regardless of any arm. Fail-closed.
# AUTOMATION_ENABLED=true

# Sensitive profile: on Windows, AES key is DPAPI-wrapped at
# private/candidate/master.key.dpapi (created automatically).
# Do NOT put CANDIDATE_DATA_KEY in this file for normal use.
# Tests/dev only:
# ALLOW_INSECURE_CANDIDATE_KEY=1
# CANDIDATE_DATA_KEY=replace-with-long-random-secret

# Prefer system Chrome for Google OAuth (JobRight Sign in with Google).
# Playwright's bundled Chromium is blocked by Google ("browser may not be secure").
BROWSER_CHANNEL=chrome

# Hard-stop pipeline on heuristic essay detection (ESSAY_REQUIRED). Default
# off — label heuristics false-positive on demographic combobox wording.
# Free-text still never auto-fills. Set true only for the human resume-essay
# flow; even then, only REQUIRED essay fields block (optional never do).
# ESSAY_REQUIRED_GATE_ENABLED=true

# Phase 5.6H: generating a resume mutates live JobRight. Fail-closed.
# Requires DRY_RUN=false as well; SUBMIT_ENABLED must stay false.
# MATERIALS_DOWNLOAD_ENABLED=true

# Phase 5: native Greenhouse fill requires both of these to mutate a form.
# Defaults stay fail-closed. SUBMIT_ENABLED must remain false until Phase 7.
# FORM_FILL_ENABLED=true
# DRY_RUN=false

# Default JobRight feed for recorder / validation
JOBRIGHT_FEED_URL=https://jobright.ai/jobs/recommend

# LLM provider keys. When ANTHROPIC_API_KEY is set it is PREFERRED at every
# LLM boundary (outreach generation, screener mapping/prediction, essay
# drafts, healer proposals, and the nav agent sidecar); OPENAI_API_KEY is
# the fallback. Set either or both. Each call is paid API spend — every
# surface stays fail-closed behind its own capability flag.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_LLM_MODEL=claude-opus-5
# OPENAI_API_KEY=sk-your-key-here
# EMAIL_LLM_MODEL=gpt-5-mini
# Nav agent (browser-use sidecar) model override. Must name a model of the
# ACTIVE provider (defaults: claude-sonnet-4-6 with Anthropic, gpt-5-mini
# with OpenAI).
# NAV_AGENT_MODEL=claude-sonnet-4-6

# Outreach email generation — fail-closed by default.
# EMAIL_GENERATION_ENABLED=true

# Phase 6 J1 authoring sidecar (inert unless enabled; python venv required)
# AGENT_AUTHORING_ENABLED=true
# LLM assist that maps unknown screener-question labels to answer-bank keys
# (labels+options+key descriptions go to the model; ANSWERS never do, and the
# chosen answer must still match a page option deterministically).
# SCREENER_LLM_MATCH_ENABLED=true
# Screener answer PREDICTION: for questions no bank key covers, the LLM
# proposes an answer from about-me.md + your existing bank answers. The
# proposal only ever lands in a review item — you approve (one click) or
# edit, and the approved answer joins screeners.json as a custom entry so
# every future occurrence fills deterministically. Nothing predicted is
# ever filled without that one-time approval.
# SCREENER_PREDICT_LLM_ENABLED=true
# Stage-1 self-improvement loop: after an armed session ends, commit+push
# artifacts/ to the current branch so the analysis agent sees fresh run
# data without a manual push. Never bypasses the pre-commit secret gate.
# ARTIFACT_AUTOPUSH_ENABLED=true
# Essay DRAFT assistant: generates suggestion drafts for required essay
# questions from private/candidate/about-me.md + the job posting. Drafts
# land INSIDE the essay review item — the human edits/approves before any
# fill; essays are never auto-filled.
# ESSAY_DRAFT_ENABLED=true
# AGENT_CDP_URL=http://127.0.0.1:9222

# Phase 6a': sidecar escalation in the fill healer. The deterministic
# in-process heal pass always runs; this flag only unlocks the sidecar layer.
# AGENT_FALLBACK_ENABLED=true

# Hands-off cycle may LAUNCH the debug Chrome itself when the CDP endpoint
# is unreachable (same executable + persistent profile as
# `npm run chrome:debug:jobright`, so your logins survive). Fail closed.
CDP_AUTOLAUNCH_ENABLED=true


# STANDING employer-portal login: the ONE email + password you use for
# every job portal (ByteDance, Workday tenants, etc.). Set both and any
# login/create-account wall the apply flow reaches is answered
# automatically — no per-site setup. Leave the password unset and portal
# auth falls back to per-host vault entries only (fail-closed by absence).
# The email should be the mailbox your verification scanner reads, so
# emailed codes/links land where Dispatch can find them. Never logged,
# never written to artifacts; .env is gitignored and hook-enforced.
# PORTAL_LOGIN_EMAIL=you@example.com
# PORTAL_LOGIN_PASSWORD=your-standing-portal-password
# Which mailbox is scanned FIRST for verification codes. Derived from the
# PORTAL_LOGIN_EMAIL domain by default (@outlook/@hotmail/@live/@msn =>
# outlook); set this to force it when your Outlook inbox uses a custom
# domain. Both mailboxes stay in the chain either way.
# VERIFICATION_MAILBOX=outlook

# Navigation layer: clicking Apply on live JobRight mutates applied-state.
# Deterministic phase (read hrefs / click Apply) requires NAVIGATION_ENABLED;
# the browser-use agent phase additionally requires AGENT_FALLBACK_ENABLED.
# NAVIGATION_ENABLED=true

# Gmail verification-code retrieval during navigation and submit recovery.
# Primary transport is a READ-ONLY Playwright scan of mail.google.com in
# your Google-authenticated browser session (the same login JobRight uses)
# — no API token needed. The gmail.readonly REST API is used only if a
# token exists (npm run gmail:auth; Google usually blocks this scope for
# unverified apps — that's why the browser path is primary). Send is
# banned by check:forbidden either way.
# GMAIL_VERIFICATION_ENABLED=true

# Read-only Outlook web mailbox scan for submit verification codes
# (navigation + DOM reads in the operator's session; never compose/send).
# OUTLOOK_VERIFICATION_ENABLED=true
