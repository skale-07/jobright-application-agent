{
  "$description": "Dispatch design tokens — machine-readable mirror of frontend/src/styles/tokens.css (which stays authoritative for the running UI). tests/unit/design-tokens.test.ts asserts the two never drift. Meanings and usage rules: DESIGN.md.",
  "$schema_note": "Shape follows the W3C Design Tokens Community Group draft loosely: {$type, $value} leaves grouped by theme.",
  "$theme_note": "light is the DEFAULT theme (Calm direction, operator directive 2026-08-21); dark is applied by OS preference or the explicit toggle.",
  "font": {
    "mono": {
      "$type": "fontFamily",
      "$value": "\"SFMono-Regular\", ui-monospace, \"Cascadia Code\", Menlo, Consolas, monospace",
      "$description": "Anything the operator might copy, grep, or compare: ids, hashes, states, evidence, log lines, the wordmark."
    },
    "ui": {
      "$type": "fontFamily",
      "$value": "\"Inter Variable\", \"Inter\", ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif",
      "$description": "Prose, labels, buttons. Self-hosted via @fontsource-variable/inter — no CDN, so the console still renders correctly with no network."
    }
  },
  "type": {
    "$description": "The only sizes permitted in components. base/sm/xs/lg are DESIGN.md's original documented scale; 2xs, md and xl extend it at the ends.",
    "2xs": { "$type": "dimension", "$value": "0.6875rem", "$description": "badges, uppercase micro-labels" },
    "xs": { "$type": "dimension", "$value": "0.78rem", "$description": "table headers, hints, log lines" },
    "sm": { "$type": "dimension", "$value": "0.875rem", "$description": "secondary text, dense rows, controls" },
    "base": { "$type": "dimension", "$value": "0.95rem", "$description": "body" },
    "md": { "$type": "dimension", "$value": "1.05rem", "$description": "card and section titles" },
    "lg": { "$type": "dimension", "$value": "1.25rem", "$description": "page headings" },
    "xl": { "$type": "dimension", "$value": "1.5rem", "$description": "hero title, stat values" }
  },
  "space": {
    "$description": "All component padding/margin rides this scale, varied by hierarchy. Identical spacing everywhere is a templated look, not a designed one.",
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.5rem" },
    "6": { "$type": "dimension", "$value": "2rem" },
    "7": { "$type": "dimension", "$value": "3rem", "$description": "between major page sections — the deliberate breathing room" }
  },
  "motion": {
    "$description": "Motion is only ever a state change or an arrival, never decoration. Every use is wrapped by the prefers-reduced-motion guard in base.css.",
    "duration-fast": { "$type": "duration", "$value": "120ms", "$description": "hover, focus, press" },
    "duration-base": { "$type": "duration", "$value": "200ms", "$description": "arrivals, expands, state transitions" },
    "ease-out": { "$type": "cubicBezier", "$value": "cubic-bezier(0.16, 1, 0.3, 1)" }
  },
  "color": {
    "dark": {
      "bg": { "$type": "color", "$value": "#0d1117", "$description": "page ground" },
      "bg-raised": { "$type": "color", "$value": "#161b22", "$description": "cards, modals" },
      "bg-inset": { "$type": "color", "$value": "#010409", "$description": "sidebar, wells, code blocks" },
      "bg-hover": { "$type": "color", "$value": "#1c2129", "$description": "hover rows" },
      "border": { "$type": "color", "$value": "#30363d" },
      "border-strong": { "$type": "color", "$value": "#484f58" },
      "text": { "$type": "color", "$value": "#e6edf3" },
      "text-dim": { "$type": "color", "$value": "#8b949e" },
      "text-faint": { "$type": "color", "$value": "#6e7681" },
      "accent": { "$type": "color", "$value": "#58a6ff", "$description": "navigation, links, in-progress; the brand color" },
      "ok": { "$type": "color", "$value": "#3fb950", "$description": "verified facts ONLY" },
      "warn": { "$type": "color", "$value": "#d29922", "$description": "needs attention, not human-blocked" },
      "danger": { "$type": "color", "$value": "#f85149", "$description": "needs-human, destructive, ARMED" },
      "purple": { "$type": "color", "$value": "#bc8cff", "$description": "agent/LLM-touched surfaces" }
    },
    "light": {
      "bg": { "$type": "color", "$value": "#f6f8fa" },
      "bg-raised": { "$type": "color", "$value": "#ffffff" },
      "bg-inset": { "$type": "color", "$value": "#eef1f4" },
      "bg-hover": { "$type": "color", "$value": "#f0f3f6" },
      "border": { "$type": "color", "$value": "#d0d7de" },
      "border-strong": { "$type": "color", "$value": "#afb8c1" },
      "text": { "$type": "color", "$value": "#1f2328" },
      "text-dim": { "$type": "color", "$value": "#59636e" },
      "text-faint": { "$type": "color", "$value": "#818b98" },
      "accent": { "$type": "color", "$value": "#0969da" },
      "ok": { "$type": "color", "$value": "#1a7f37" },
      "warn": { "$type": "color", "$value": "#9a6700" },
      "danger": { "$type": "color", "$value": "#cf222e" },
      "purple": { "$type": "color", "$value": "#8250df" }
    }
  },
  "shadow": {
    "$description": "Depth, not palette. Two steps only: sm for resting elevation, default for the one modal.",
    "dark": {
      "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(1, 4, 9, 0.4)" },
      "default": { "$type": "shadow", "$value": "0 8px 24px rgba(1, 4, 9, 0.55)" }
    },
    "light": {
      "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(31, 35, 40, 0.06)" },
      "default": { "$type": "shadow", "$value": "0 8px 24px rgba(31, 35, 40, 0.12)" }
    }
  },
  "radius": {
    "default": { "$type": "dimension", "$value": "8px", "$description": "cards, modals, banners" },
    "sm": { "$type": "dimension", "$value": "5px", "$description": "buttons, inputs, chips" },
    "lg": { "$type": "dimension", "$value": "12px", "$description": "hero and other large surfaces — radius varies with surface size" }
  },
  "layer": {
    "$description": "The only z-index values in the system.",
    "sticky": { "$type": "number", "$value": "30" },
    "banner": { "$type": "number", "$value": "40" },
    "modal": { "$type": "number", "$value": "50" }
  },
  "layout": {
    "sidebar-width": { "$type": "dimension", "$value": "13.5rem" },
    "breakpoint-compact": { "$type": "dimension", "$value": "960px", "$description": "below this the sidebar becomes a top bar" }
  }
}
