{
  "$description": "Dispatch design tokens — machine-readable mirror of frontend/src/styles/tokens.css (which stays authoritative for the running UI). tests/unit/design-tokens.test.ts asserts the two never drift. Meanings and usage rules: DESIGN.md.",
  "$schema_note": "Shape follows the W3C Design Tokens Community Group draft loosely: {$type, $value} leaves grouped by theme.",
  "font": {
    "mono": {
      "$type": "fontFamily",
      "$value": "\"SFMono-Regular\", ui-monospace, \"Cascadia Code\", Menlo, Consolas, monospace",
      "$description": "Anything the operator might copy, grep, or compare: ids, hashes, states, evidence, log lines, the wordmark."
    },
    "ui": {
      "$type": "fontFamily",
      "$value": "\"Inter\", ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif",
      "$description": "Prose, labels, buttons."
    }
  },
  "color": {
    "dark": {
      "bg": { "$type": "color", "$value": "#0d1117", "$description": "page ground" },
      "bg-raised": { "$type": "color", "$value": "#161b22", "$description": "cards, modals" },
      "bg-inset": { "$type": "color", "$value": "#010409", "$description": "sidebar, wells, code blocks" },
      "bg-hover": { "$type": "color", "$value": "#1c2129", "$description": "hover rows" },
      "border": { "$type": "color", "$value": "#30363d" },
      "border-strong": { "$type": "color", "$value": "#484f58" },
      "text": { "$type": "color", "$value": "#e6edf3" },
      "text-dim": { "$type": "color", "$value": "#8b949e" },
      "text-faint": { "$type": "color", "$value": "#6e7681" },
      "accent": { "$type": "color", "$value": "#58a6ff", "$description": "navigation, links, in-progress; the brand color" },
      "ok": { "$type": "color", "$value": "#3fb950", "$description": "verified facts ONLY" },
      "warn": { "$type": "color", "$value": "#d29922", "$description": "needs attention, not human-blocked" },
      "danger": { "$type": "color", "$value": "#f85149", "$description": "needs-human, destructive, ARMED" },
      "purple": { "$type": "color", "$value": "#bc8cff", "$description": "agent/LLM-touched surfaces" }
    },
    "light": {
      "bg": { "$type": "color", "$value": "#f6f8fa" },
      "bg-raised": { "$type": "color", "$value": "#ffffff" },
      "bg-inset": { "$type": "color", "$value": "#eef1f4" },
      "bg-hover": { "$type": "color", "$value": "#f0f3f6" },
      "border": { "$type": "color", "$value": "#d0d7de" },
      "border-strong": { "$type": "color", "$value": "#afb8c1" },
      "text": { "$type": "color", "$value": "#1f2328" },
      "text-dim": { "$type": "color", "$value": "#59636e" },
      "text-faint": { "$type": "color", "$value": "#818b98" },
      "accent": { "$type": "color", "$value": "#0969da" },
      "ok": { "$type": "color", "$value": "#1a7f37" },
      "warn": { "$type": "color", "$value": "#9a6700" },
      "danger": { "$type": "color", "$value": "#cf222e" },
      "purple": { "$type": "color", "$value": "#8250df" }
    }
  },
  "radius": {
    "default": { "$type": "dimension", "$value": "8px", "$description": "cards, modals, banners" },
    "sm": { "$type": "dimension", "$value": "5px", "$description": "buttons, inputs, chips" }
  },
  "layout": {
    "sidebar-width": { "$type": "dimension", "$value": "13.5rem" },
    "spacing-scale": {
      "$type": "dimensionScale",
      "$value": ["0.25rem", "0.5rem", "0.75rem", "1rem", "1.5rem", "2rem"],
      "$description": "All component padding/margin rides this scale."
    }
  }
}
